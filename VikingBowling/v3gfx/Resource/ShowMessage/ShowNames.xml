<!--
		The white name panel is sized for the number of names the message actually carries.
		A ";" separated value is one column per player count, counted from one: the first
		column is used for one name, the last for eight. CGdiMON::ShowTextMessage counts the
		names and BitmapFromXml picks the column, so any element in this file can be written
		that way - not only the two heights below. Fewer columns than counts is allowed, the
		last one is then used for every count above it.
		Heights: 152 for one name and 94 more per name after that, which is the row spacing.
-->
	<rectangle_fill>
		<rect>
			<x>465</x>
			<y>220</y>
			<w>990</w>
			<h>152;246;340;434;528;622;716;810</h>
		</rect>
		<color>
			<trans>255</trans>
			<red>250</red>
			<green>250</green>
			<blue>250</blue>
		</color>
	</rectangle_fill>
			
	</layer_before_1>

