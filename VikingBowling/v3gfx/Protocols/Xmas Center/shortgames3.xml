	<!-- Protocol theme -->
	<layer_before_1>
		<import>c:\viking2001\v3gfx\Resource\Themes\XmasCenter_Before.xml</import>
	</layer_before_1>

	<layer_after_2>	
		<import>c:\viking2001\v3gfx\Resource\Themes\XmasCenter_After.xml</import>
	</layer_after_2>
	
	<layer_after_1>	
		<import>CommonInfo.xml</import>
	</layer_after_1>
	<import>MessageInfo.xml</import>
	<import>TeamInfo.xml</import>	
</protocol>
